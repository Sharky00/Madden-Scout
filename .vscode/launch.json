{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Madden Scout: Analyze Source Video",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/video_intake.py",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": [
        "${workspaceFolder}/output/downloads/source_video.mp4",
        "--output-dir",
        "${workspaceFolder}/output",
        "--layout-config",
        "${workspaceFolder}/configs/layouts/source_video.json",
        "--calibration-file",
        "${workspaceFolder}/configs/calibration/source_video_first_14.json",
        "--start-seconds",
        "0",
        "--max-duration-seconds",
        "420",
        "--sample-every-n-frames",
        "90",
        "--max-frames",
        "140",
        "--ocr-workers",
        "4"
      ]
    },
    {
      "name": "Madden Scout: Fast Cached Analysis",
